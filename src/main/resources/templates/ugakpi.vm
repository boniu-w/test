import org.springframework.web.multipart.MultipartFile;
import org.springframework.util.CollectionUtils;
import ci.dp.peq.strategy.asset.svc.excel.util.ExcelUtil;
import ci.dp.peq.strategy.asset.svc.service.${excel};
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import java.util.ArrayList;
import java.util.List;

@PostMapping(value = "/getExcel")
@Operation(summary = "获取excel数据")
public R<Object> getExcel(HttpServletRequest request,
                          HttpServletResponse response) {
    try {
        List<MultipartFile> uploadFiles = ExcelUtil.getUploadFiles(request);
        List<${dto}> excel = new ArrayList<>();
        if (!CollectionUtils.isEmpty(uploadFiles)) {
            for (MultipartFile uploadFile : uploadFiles) {
                excel = ${service}.getExcel(uploadFile, response, "uga");
            }
        }
        if ("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet".equals(response.getContentType())) {
            return null;
        }
        return R.ok(excel, "预防性维修和故障性维修工单数量比 导入成功");
    } catch (Exception e) {
        log.error("预防性维修和故障性维修工单数量比 导入出错", e);
        return R.failed("预防性维修和故障性维修工单数量比 导入出错");
    }
}

@GetMapping(value = "/exportTemplate")
@Operation(summary = "模板导出")
public void exportExcelTemplate(${dto} params, HttpServletResponse response) throws Exception {
    ${service}.exportTemplate(params, response);
}

@GetMapping(value = "/export")
@Operation(summary = "数据导出")
public void exportExcel(${dto} params, HttpServletResponse response) throws Exception {
    ${service}.exportData(params, response);
}


